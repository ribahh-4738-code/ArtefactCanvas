{
  "name": "artefactcanvas-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "node --env-file=../.env ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=../.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:push": "node --env-file=../.env ./node_modules/prisma/build/index.js db push",
    "seed": "node --env-file=../.env ./node_modules/tsx/dist/cli.mjs src/scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
